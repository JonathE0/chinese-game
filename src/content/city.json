  "people": [
    {
      "id": "clerk",
      "zh": "上班的人",
      "pinyin": "shàngbān de rén",
      "en": "an office worker",
      "color": "#4a5a6b",
      "x": -4.2,
      "z": 11,
      "rot": 160,
      "lines": [
        {
          "zh": "上班快迟到了！",
          "pinyin": "Shàngbān kuài chídào le!",
          "en": "I am nearly late for work!",
          "note": "迟到 (chídào) is to arrive late. 快…了 means it is about to happen."
        },
        {
          "zh": "这边的地铁很方便。",
          "pinyin": "Zhèbiān de dìtiě hěn fāngbiàn.",
          "en": "The metro round here is very convenient.",
          "note": "方便 (fāngbiàn) — convenient. A very common word in a city."
        },
        {
          "zh": "你也是坐地铁来的吗？",
          "pinyin": "Nǐ yě shì zuò dìtiě lái de ma?",
          "en": "Did you come by metro too?",
          "note": "坐地铁 — to travel by metro. 坐 is the verb for riding most vehicles."
        }
      ]
    },
    {
      "id": "student",
      "zh": "学生",
      "pinyin": "xuésheng",
      "en": "a student",
      "color": "#7d5f86",
      "x": 4.6,
      "z": -6,
      "rot": -20,
      "lines": [
        {
          "zh": "我在等朋友。",
          "pinyin": "Wǒ zài děng péngyou.",
          "en": "I am waiting for a friend.",
          "note": "在 before a verb marks something happening right now."
        },
        {
          "zh": "这栋大楼有三十层。",
          "pinyin": "Zhè dòng dàlóu yǒu sānshí céng.",
          "en": "That building has thirty floors.",
          "note": "栋 (dòng) is the measure word for a building; 层 (céng) counts floors."
        },
        {
          "zh": "你想去看电影吗？",
          "pinyin": "Nǐ xiǎng qù kàn diànyǐng ma?",
          "en": "Do you want to go and see a film?",
          "note": "看电影 — literally to look at a film."
        }
      ]
    },
    {
      "id": "busker",
      "zh": "街头艺人",
      "pinyin": "jiētóu yìrén",
      "en": "a busker",
      "color": "#8c6b4a",
      "x": -4.8,
      "z": -19,
      "rot": 30,
      "lines": [
        {
          "zh": "城里晚上更热闹。",
          "pinyin": "Chéng lǐ wǎnshang gèng rènao.",
          "en": "The city is livelier at night.",
          "note": "热闹 (rènao) — bustling, lively with people. A compliment in Chinese."
        },
        {
          "zh": "喜欢这首歌吗？",
          "pinyin": "Xǐhuan zhè shǒu gē ma?",
          "en": "Do you like this song?",
          "note": "首 (shǒu) is the measure word for songs and poems."
        },
        {
          "zh": "我从早上唱到晚上。",
          "pinyin": "Wǒ cóng zǎoshang chàng dào wǎnshang.",
          "en": "I sing from morning until night.",
          "note": "从…到… — from X to Y, for both time and place."
        }
      ]
    }
  ],
