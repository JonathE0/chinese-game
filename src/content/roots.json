      "id": "roots-fruit",
      "zh": "水果摊",
      "pinyin": "Shuǐguǒ tān",
      "en": "The fruit stand",
      "clue": {
        "zh": "爷爷的旧照片里，水果摆在广场西边的木桌上。",
        "pinyin": "Yéye de jiù zhàopiàn lǐ, shuǐguǒ bǎi zài guǎngchǎng xībian de mùzhuō shàng.",
        "en": "In Grandfather’s old photograph, fruit sits on a wooden table west of the square."
      },
      "place": "town",
      "x": -6.4,
      "z": 0,
      "radius": 14,
      "subject": "fruitstand",
      "image": "/images/roots/fruit.png"
    },
    {
      "id": "roots-square",
      "zh": "广场上的朋友",
      "pinyin": "Guǎngchǎng shàng de péngyou",
      "en": "Friends in the square",
      "clue": {
        "zh": "这是爷爷熟悉的广场。喷泉还在吗？",
        "pinyin": "Zhè shì yéye shúxī de guǎngchǎng. Pēnquán hái zài ma?",
        "en": "This is the square Grandfather knew. Is the fountain still there?"
      },
      "place": "town",
      "x": 0,
      "z": 0,
      "radius": 18,
      "subject": "fountain",
      "image": "/images/roots/square.png"
    },
    {
      "id": "roots-home",
      "zh": "旧家的门",
      "pinyin": "Jiù jiā de mén",
      "en": "The old front door",
      "clue": {
        "zh": "信上的地址指向广场东南边的小屋。",
        "pinyin": "Xìn shàng de dìzhǐ zhǐxiàng guǎngchǎng dōngnánbian de xiǎowū.",
        "en": "The address points to the house southeast of the square."
      },
      "place": "town",
      "x": 11,
      "z": 14,
