{
  "opening": {
    "zh": "爷爷去世后，给你留下了一本旧相册、一封信和一把钥匙。你来到青禾，想看看他曾经生活的地方。",
    "pinyin": "Yéye qùshì hòu, gěi nǐ liúxià le yì běn jiù xiàngcè, yì fēng xìn hé yì bǎ yàoshi. Nǐ láidào Qīnghé, xiǎng kànkan tā céngjīng shēnghuó de dìfang.",
    "en": "After your grandfather passed away, he left you an old album, a letter and a key. You have come to Qinghe to discover the places where he lived."
  },
  "letter": {
    "zh": "如果你有机会，就去青禾看看。那里有我年轻时的回忆。慢慢走，别着急。",
    "pinyin": "Rúguǒ nǐ yǒu jīhuì, jiù qù Qīnghé kànkan. Nàli yǒu wǒ niánqīng shí de huíyì. Mànman zǒu, bié zháojí.",
    "en": "If you have the chance, visit Qinghe. There are memories of my younger days there. Take your time."
  },
  "film": {
    "starter": 6,
    "pack": 5,
    "price": 10
  },
  "memories": [
