  "caretaker": {
    "zh": "周叔叔",
    "pinyin": "Zhōu shūshu",
    "en": "Uncle Zhou",
    "x": -5,
    "z": 1.5,
    "greeting": {
      "zh": "你好！想买点水果吗？",
      "pinyin": "Nǐ hǎo! Xiǎng mǎi diǎn shuǐguǒ ma?",
      "en": "Hello! Would you like some fruit?"
    },
    "memory": {
      "zh": "这张照片真熟悉！当年我和你爷爷一起开了这个水果摊。他总会多放一个橘子，送给老邻居。",
      "pinyin": "Zhè zhāng zhàopiàn zhēn shúxī! Dāngnián wǒ hé nǐ yéye yìqǐ kāi le zhège shuǐguǒ tān. Tā zǒng huì duō fàng yí ge júzi, sòng gěi lǎo línjū.",
      "en": "I know this photograph! Your grandfather and I opened this fruit stand together. He always slipped in an extra orange for an old neighbour."
    }
  },
