    {
      "id": "roots-next",
      "zh": "另一张合影",
      "pinyin": "Lìng yì zhāng héyǐng",
      "en": "Another photograph",
      "clue": {
        "zh": "水果摊的伙伴把这张合影送给你。下一段故事，留到以后慢慢寻找。",
        "pinyin": "Shuǐguǒ tān de huǒbàn bǎ zhè zhāng héyǐng sònggěi nǐ. Xià yí duàn gùshi, liú dào yǐhòu mànman xúnzhǎo.",
        "en": "Your partner gives you this group photograph. Its next story will unfold in a later chapter."
      },
      "keepsake": true,
      "image": "/images/roots/next.png"
    }
  ],
