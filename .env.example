# Cloud saves (optional). Copy this file to .env.local and fill in both values from
# Supabase → Project Settings → API. Leave them unset and the game has no cloud save at all.
# Both values are public by design: they end up in the page, and Row Level Security protects the data.
# Never put the service_role key or the Google client secret here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
